generator client {
    provider = "prisma-client-js"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

model User {
    id                   String    @id @default(cuid())
    userId               Int       @unique @default(0) // Sequential user ID starting from 0
    email                String    @unique
    name                 String
    createdAt            DateTime  @default(now())
    updatedAt            DateTime  @updatedAt
    password             String?
    address              String?
    avatar               String?
    bio                  String?
    businessType         String?
    city                 String?
    companyName          String?
    companySize          String?
    country              String?
    degree               String?
    graduationYear       Int?
    industry             String?
    institutionName      String?
    isActive             Boolean   @default(true)
    jobTitle             String?
    lastLoginAt          DateTime?
    major                String?
    phoneNumber          String?
    postalCode           String?
    preferredLanguage    String?   @default("en")
    registrationNumber   String?
    state                String?
    studentId            String?
    taxId                String?
    timezone             String?   @default("UTC")
    userType             UserType  @default(REGULAR)
    website              String?
    image                String?
    emailVerified        DateTime?
    roleId               String? // New field for role assignment
    accounts             Account[]
    assignedOrders       Order[]   @relation("AssignedOrders")
    orders               Order[]
    paymentConfirmations Payment[] @relation("PaymentConfirmations")
    sessions             Session[]
    role                 Role?     @relation(fields: [roleId], references: [id])

    @@map("users")
}

model Service {
    id               String   @id @default(cuid())
    serviceId        Int      @unique @default(0) // Sequential service ID starting from 0
    name             String   @unique
    shortDescription String? // Brief description for service cards
    description      String?  @db.Text // Comprehensive description
    price            Decimal  @db.Decimal(10, 2)
    isActive         Boolean  @default(true)
    createdAt        DateTime @default(now())
    updatedAt        DateTime @updatedAt

    // Basic Classification
    category    String? // Web Design, Development, Hosting, Content, Marketing, Consulting, Support, Other
    serviceType String? // web-design, development, hosting, content-writing, marketing, consulting, support, other

    // Conditional Fields (only relevant for certain service types)
    webDesignType String? // Landing Page, Corporate Website, E-commerce, Portfolio, Blog, Custom Application, Other (only when serviceType = 'web-design')

    // Delivery & Timing
    deliveryTime String? // e.g., "7-14 days", "Instant", "3-5 days"
    duration     String? // 1-3 days, 1 week, 2 weeks, 1 month, 2-3 months, 3-6 months, 6+ months, Ongoing
    isOnline     Boolean @default(true) // Online vs In Person delivery

    // Service Details
    features String? @db.Text // Key features, one per line
    image    String? // Service image URL

    // Custom Fields (flexible JSON storage for additional information)
    customFields String? @db.Text // JSON string containing:
    // - pagesIncluded: number (number of pages included)
    // - revisions: number (number of revisions included)
    // - technologies: string (e.g., "React, Node.js, MongoDB")
    // - Any other custom fields based on service type

    // Phases/Stages (optional structured data for service phases)
    phases String? @db.Text // JSON string containing:
    // - showPhases: boolean (whether to show phases)
    // - phases: array of { name: string, description: string }
    // Example: {"showPhases": true, "phases": [{"name": "Phase 1", "description": "Meeting"}, {"name": "Phase 2", "description": "Collection"}]}

    // Relationships
    orders Order[]

    @@index([serviceType])
    @@index([category])
    @@index([isActive])
    @@index([createdAt])
    @@index([webDesignType])
    @@index([isOnline])
    @@map("services")
}

model Order {
    id            String               @id @default(cuid())
    orderId       Int                  @unique @default(0) // Sequential order ID starting from 0
    userId        String
    serviceId     String
    price         Decimal              @db.Decimal(10, 2)
    status        OrderStatus          @default(PENDING)
    createdAt     DateTime             @default(now())
    updatedAt     DateTime             @updatedAt
    quantity      Int                  @default(1)
    totalPrice    Decimal              @default(0.00) @db.Decimal(10, 2)
    webDesignType String?
    adminNotes    String?
    assignedTo    String?
    orderNumber   String               @unique
    priority      OrderPriority        @default(NORMAL)
    statusHistory OrderStatusHistory[]
    assignedAdmin User?                @relation("AssignedOrders", fields: [assignedTo], references: [id])
    service       Service              @relation(fields: [serviceId], references: [id])
    user          User                 @relation(fields: [userId], references: [id])
    payments      Payment[]

    @@index([userId])
    @@index([serviceId])
    @@index([status])
    @@index([assignedTo])
    @@index([createdAt])
    @@map("orders")
}

model Payment {
    id              String        @id @default(cuid())
    paymentId       Int           @unique @default(0) // Sequential payment ID starting from 0
    orderId         String
    amount          Decimal       @db.Decimal(10, 2)
    method          PaymentMethod
    referenceNo     String?
    status          PaymentStatus @default(PENDING)
    paidAt          DateTime?
    confirmedAt     DateTime?
    createdAt       DateTime      @default(now())
    updatedAt       DateTime      @updatedAt
    adminNotes      String?
    confirmedBy     String?
    paymentNumber   String        @unique
    transactionId   String?       @unique
    confirmedByUser User?         @relation("PaymentConfirmations", fields: [confirmedBy], references: [id])
    order           Order         @relation(fields: [orderId], references: [id])

    @@index([orderId])
    @@index([status])
    @@index([transactionId])
    @@index([confirmedBy])
    @@index([createdAt])
    @@map("payments")
}

model OrderStatusHistory {
    id        String      @id @default(cuid())
    orderId   String
    status    OrderStatus
    note      String?
    changedAt DateTime    @default(now())
    order     Order       @relation(fields: [orderId], references: [id])

    @@index([orderId], map: "order_status_history_orderId_fkey")
    @@map("order_status_history")
}

model Account {
    id                String  @id @default(cuid())
    userId            String
    type              String
    provider          String
    providerAccountId String
    refresh_token     String? @db.Text
    access_token      String? @db.Text
    expires_at        Int?
    token_type        String?
    scope             String?
    id_token          String? @db.Text
    session_state     String?
    user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
    @@index([userId], map: "accounts_userId_fkey")
    @@map("accounts")
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId], map: "sessions_userId_fkey")
    @@map("sessions")
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
    @@map("verification_tokens")
}

enum UserType {
    REGULAR
    CORPORATION
    EDUCATION
    ADMIN
}

enum OrderStatus {
    PENDING
    IN_PROGRESS
    COMPLETED
    CANCELLED
}

enum PaymentMethod {
    CASH
    CARD
    BANK_TRANSFER
    DIGITAL_WALLET
    CRYPTOCURRENCY
}

enum PaymentStatus {
    PENDING
    PROCESSING
    COMPLETED
    FAILED
    REFUNDED
}

enum OrderPriority {
    LOW
    NORMAL
    HIGH
}

model Role {
    id          String   @id @default(cuid())
    name        String   @unique
    description String?
    isActive    Boolean  @default(true)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    // Relations
    capabilities RoleCapability[]
    users        User[]

    @@map("roles")
}

model RoleCapability {
    id         String   @id @default(cuid())
    roleId     String
    capability String // e.g., "can_create_orders"
    isGranted  Boolean  @default(true)
    createdAt  DateTime @default(now())

    // Relations
    role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

    @@unique([roleId, capability], name: "roleId_capability")
    @@map("role_capabilities")
}
