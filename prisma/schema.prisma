generator client {
    provider = "prisma-client-js"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

model User {
    id                                      String            @id @default(cuid())
    email                                   String            @unique
    name                                    String
    createdAt                               DateTime          @default(now())
    updatedAt                               DateTime          @updatedAt
    password                                String?
    address                                 String?
    avatar                                  String?
    bio                                     String?
    businessType                            String?
    city                                    String?
    companyName                             String?
    companySize                             String?
    country                                 String?
    degree                                  String?
    graduationYear                          Int?
    industry                                String?
    institutionName                         String?
    isActive                                Boolean           @default(true)
    jobTitle                                String?
    lastLoginAt                             DateTime?
    major                                   String?
    phoneNumber                             String?
    postalCode                              String?
    preferredLanguage                       String?           @default("en")
    registrationNumber                      String?
    state                                   String?
    studentId                               String?
    taxId                                   String?
    timezone                                String?           @default("UTC")
    website                                 String?
    image                                   String?
    emailVerified                           DateTime?
    resetToken                              String?
    resetTokenExpiry                        DateTime?
    roleId                                  String?
    userType                                users_userType    @default(CLIENT)
    accounts                                Account[]
    billings                                Billing[]
    invoices                                Invoice[]
    payment_methods                         payment_methods[]
    payments_payments_confirmedByTousers    payments[]        @relation("payments_confirmedByTousers")
    payments_payments_userIdTousers         payments[]        @relation("payments_userIdTousers")
    projects_projects_assignedUserIdTousers Project[]         @relation("projects_assignedUserIdTousers")
    projects_projects_userIdTousers         Project[]         @relation("projects_userIdTousers")
    sessions                                Session[]
    role                                    Role?             @relation(fields: [roleId], references: [id])

    @@index([roleId], map: "users_roleId_fkey")
    @@map("users")
}

model Project {
    id                                   String       @id @default(cuid())
    projectId                            Int          @unique @default(autoincrement())
    userId                               String
    name                                 String
    description                          String?      @db.Text
    isActive                             Boolean      @default(true)
    createdAt                            DateTime     @default(now())
    updatedAt                            DateTime     @updatedAt
    assignedUserId                       String?
    billings                             Billing?
    invoices                             Invoice[]
    milestones                           milestones[]
    payments                             payments[]
    users_projects_assignedUserIdTousers User?        @relation("projects_assignedUserIdTousers", fields: [assignedUserId], references: [id])
    users_projects_userIdTousers         User         @relation("projects_userIdTousers", fields: [userId], references: [id], onDelete: Cascade)
    services                             Service[]
    tasks                                tasks[]

    @@unique([userId, name])
    @@index([assignedUserId])
    @@index([createdAt])
    @@index([isActive])
    @@index([userId])
    @@map("projects")
}

model Service {
    id             String   @id @default(cuid())
    projectId      String
    name           String
    description    String?  @db.Text
    price          Decimal  @db.Decimal(10, 2)
    unit           String
    estimatedHours Int?
    actualHours    Int?
    status         String   @default("PENDING")
    isActive       Boolean  @default(true)
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt
    projects       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

    @@index([isActive])
    @@index([projectId])
    @@index([status])
    @@map("services")
}

model Billing {
    id              String          @id @default(cuid())
    projectId       String          @unique
    userId          String
    status          billings_status @default(PENDING)
    totalAmount     Decimal         @default(0.00) @db.Decimal(10, 2)
    paidAmount      Decimal         @default(0.00) @db.Decimal(10, 2)
    remainingAmount Decimal         @default(0.00) @db.Decimal(10, 2)
    currency        String          @default("USD")
    billingPeriod   String?
    dueDate         DateTime?
    lastInvoiceDate DateTime?
    createdAt       DateTime        @default(now())
    updatedAt       DateTime        @updatedAt
    project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
    user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
    invoices        Invoice[]

    @@index([billingPeriod])
    @@index([projectId])
    @@index([status])
    @@index([userId])
    @@map("billings")
}

model Invoice {
    id              String            @id @default(cuid())
    invoiceNumber   String            @unique
    projectId       String
    userId          String
    status          invoices_status   @default(DRAFT)
    subtotal        Decimal           @db.Decimal(10, 2)
    taxAmount       Decimal           @db.Decimal(10, 2)
    totalAmount     Decimal           @db.Decimal(10, 2)
    currency        String            @default("USD")
    dueDate         DateTime
    issuedDate      DateTime          @default(now())
    paidDate        DateTime?
    notes           String?           @db.Text
    fiscalReceipt   Boolean           @default(false)
    taxId           String?
    businessName    String?
    businessAddress String?           @db.Text
    billingId       String
    lineItems       InvoiceLineItem[]
    billing         Billing           @relation(fields: [billingId], references: [id], onDelete: Cascade)
    project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
    user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
    payments        payments[]

    @@index([billingId])
    @@index([dueDate])
    @@index([projectId])
    @@index([status])
    @@index([userId])
    @@map("invoices")
}

model InvoiceLineItem {
    id          String   @id @default(cuid())
    invoiceId   String
    description String
    quantity    Decimal  @db.Decimal(10, 2)
    unitPrice   Decimal  @db.Decimal(10, 2)
    totalPrice  Decimal  @db.Decimal(10, 2)
    taxRate     Decimal  @default(0.0000) @db.Decimal(5, 4)
    createdAt   DateTime @default(now())
    invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

    @@index([invoiceId])
    @@map("invoice_line_items")
}

model Account {
    id                String  @id @default(cuid())
    userId            String
    type              String
    provider          String
    providerAccountId String
    refresh_token     String? @db.Text
    access_token      String? @db.Text
    expires_at        Int?
    token_type        String?
    scope             String?
    id_token          String? @db.Text
    session_state     String?
    user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
    @@index([userId], map: "accounts_userId_fkey")
    @@map("accounts")
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId], map: "sessions_userId_fkey")
    @@map("sessions")
}

model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
    @@map("verification_tokens")
}

model Role {
    id           String           @id @default(cuid())
    name         String           @unique
    description  String?
    isActive     Boolean          @default(true)
    createdAt    DateTime         @default(now())
    updatedAt    DateTime         @updatedAt
    capabilities RoleCapability[]
    users        User[]

    @@map("roles")
}

model RoleCapability {
    id         String   @id @default(cuid())
    roleId     String
    capability String
    isGranted  Boolean  @default(true)
    createdAt  DateTime @default(now())
    role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

    @@unique([roleId, capability], name: "roleId_capability")
    @@map("role_capabilities")
}

model milestones {
    id             String    @id @default(cuid())
    projectId      String
    name           String
    description    String?   @db.Text
    status         String    @default("PENDING")
    dueDate        DateTime?
    completedAt    DateTime?
    estimatedHours Int?
    actualHours    Int?
    isActive       Boolean   @default(true)
    createdAt      DateTime  @default(now())
    updatedAt      DateTime  @updatedAt
    projects       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

    @@index([isActive])
    @@index([projectId])
    @@index([status])
}

model payment_methods {
    id            String               @id
    userId        String
    type          payment_methods_type
    cardNumber    String?
    cardBrand     String?
    bankName      String?
    accountNumber String?
    isDefault     Boolean              @default(false)
    isActive      Boolean              @default(true)
    createdAt     DateTime             @default(now())
    updatedAt     DateTime
    users         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([isActive])
    @@index([isDefault])
    @@index([userId])
}

model payments {
    id                                String          @id
    paymentId                         Int             @unique @default(0)
    amount                            Decimal         @db.Decimal(10, 2)
    method                            payments_method
    referenceNo                       String?
    status                            payments_status @default(PENDING)
    paidAt                            DateTime?
    confirmedAt                       DateTime?
    createdAt                         DateTime        @default(now())
    updatedAt                         DateTime
    adminNotes                        String?
    confirmedBy                       String?
    paymentNumber                     String          @unique
    transactionId                     String?         @unique
    description                       String?
    userId                            String
    currency                          String          @default("USD")
    failureReason                     String?         @db.Text
    invoiceId                         String?
    notes                             String?         @db.Text
    projectId                         String?
    refundAmount                      Decimal?        @db.Decimal(10, 2)
    refundDate                        DateTime?
    users_payments_confirmedByTousers User?           @relation("payments_confirmedByTousers", fields: [confirmedBy], references: [id])
    invoices                          Invoice?        @relation(fields: [invoiceId], references: [id])
    projects                          Project?        @relation(fields: [projectId], references: [id])
    users_payments_userIdTousers      User            @relation("payments_userIdTousers", fields: [userId], references: [id])

    @@index([confirmedBy])
    @@index([createdAt])
    @@index([invoiceId])
    @@index([projectId])
    @@index([status])
    @@index([transactionId])
    @@index([userId])
}

model tasks {
    id             String    @id @default(cuid())
    projectId      String
    name           String
    description    String?   @db.Text
    status         String    @default("PENDING")
    dueDate        DateTime?
    completedAt    DateTime?
    estimatedHours Int?
    actualHours    Int?
    assignedTo     String?
    priority       String    @default("MEDIUM")
    isActive       Boolean   @default(true)
    createdAt      DateTime  @default(now())
    updatedAt      DateTime  @updatedAt
    projects       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

    @@index([isActive])
    @@index([priority])
    @@index([projectId])
    @@index([status])
}

enum payment_methods_type {
    CARD
    BANK_ACCOUNT
}

enum billings_status {
    PENDING
    INVOICED
    PAID
    OVERDUE
    CANCELLED
}

enum payments_method {
    CASH
    CARD
    BANK_TRANSFER
    DIGITAL_WALLET
    CRYPTOCURRENCY
}

enum invoices_status {
    DRAFT
    SENT
    PAID
    OVERDUE
    CANCELLED
}

enum payments_status {
    PENDING
    PROCESSING
    COMPLETED
    FAILED
    REFUNDED
}

enum users_userType {
    CLIENT
    MANAGER
    ADMIN
}
